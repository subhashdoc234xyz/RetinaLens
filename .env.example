# GROQ_API_KEY: Optional fast inference key from https://console.groq.com/keys
# Used for fast vision inference (Llama 3.2 Vision) and high-speed medical explainability.
GROQ_API_KEY=

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=

# SUPABASE_URL: URL of your Supabase project (e.g. https://xyzcompany.supabase.co)
# Used for PostgreSQL database, Supabase Auth, and Storage bucket for retinal scans.
SUPABASE_URL=

# SUPABASE_ANON_KEY: Public anonymous API key for your Supabase project.
SUPABASE_ANON_KEY=

# SUPABASE_SERVICE_ROLE_KEY: Optional elevated key for backend administrative queries.
SUPABASE_SERVICE_ROLE_KEY=

# MODEL_API_URL: Optional external inference endpoint for MATLAB / TFLite edge model.
# e.g. http://localhost:5000/predict or https://rural-inference-node.org/api/v1/dr-grade
MODEL_API_URL=
